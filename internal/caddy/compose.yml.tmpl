services:
  caddy:
{{- if .DNS}}
    build: .
{{- else}}
    image: lucaslorentz/caddy-docker-proxy:2.9
{{- end}}
    container_name: herald-caddy
    restart: always
    ports:
      - "80:80"
      - "443:443"
      - "443:443/udp"
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock:ro
      - caddy_data:/data
      - caddy_config:/config
    environment:
      - CADDY_INGRESS_NETWORKS=caddy
{{- if .DNS}}
      - HETZNER_API_TOKEN=${HERALD_HETZNER_TOKEN:?}
{{- end}}
    networks:
      - caddy
    labels:
      caddy.email: "{{.AcmeEmail}}"
{{- if .AcmeCA}}
      caddy.acme_ca: "{{.AcmeCA}}"
{{- end}}
{{- if .DeployDomain}}
      caddy_0: "{{.DeployDomain}}"
      caddy_0.reverse_proxy: "{{.GatewayIP}}:{{.HeraldPort}}"
{{- end}}
{{- if .DNS}}
      # One explicit issuer instead of acme_dns: Caddy fills acme_dns into an
      # issuer by replacing its DNS challenge config, which drops resolvers.
      # email and acme_ca still fill in from the globals above.
      caddy.cert_issuer: "acme"
      caddy.cert_issuer.dns: "hetzner {env.HETZNER_API_TOKEN}"
{{- if .Resolvers}}
      caddy.cert_issuer.resolvers: "{{.Resolvers}}"
{{- end}}
{{- if .PropagationDelay}}
      caddy.cert_issuer.propagation_delay: "{{.PropagationDelay}}"
{{- end}}
{{- if .Wildcard}}
      # Caddy 2.11 serves a name an automated wildcard covers from that
      # wildcard; it removed auto_https prefer_wildcard, which now fails to parse.
      caddy_1: "{{.Wildcard}}"
      caddy_1.respond: "404"
{{- end}}
{{- end}}

volumes:
  caddy_data:
  caddy_config:

networks:
  caddy:
    external: true
